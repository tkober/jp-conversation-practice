# Postgres connection. The host is the postgres-core container, reachable by
# name over the shared external network (postgres-core-net). DB_URL carries only
# host/port/database — credentials are supplied per role below.
# The jp_conversation database and the jp_conversation_app / jp_conversation_owner
# roles must already exist on postgres-core (see the bootstrap SQL next to this
# stack). The tables themselves are created by the backend on startup,
# connecting as the owner role.
DB_URL=postgresql://postgres-core:5432/jp_conversation
DB_USER=jp_conversation_app
DB_PASSWORD=
DB_OWNER_USER=jp_conversation_owner
DB_OWNER_PASSWORD=

# OpenAI. Optional here: the Settings screen stores a key in the database and
# that takes precedence. Setting it here means the app works before you have
# opened the UI once.
OPENAI_API_KEY=

# Optional model overrides. All of these are also editable in the Settings
# screen, which wins over anything set here.
# REALTIME_MODEL=gpt-realtime-2.1-mini
# ANALYSIS_MODEL=gpt-4o-mini
# SCENARIO_ASSISTANT_MODEL=gpt-4o
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# REALTIME_VOICE=marin
# How long a pause may last before the tutor answers: low | medium | high | auto.
# REALTIME_VAD_EAGERNESS=low

# Optional: context material. Images a scenario can put in front of the learner.
# The frontend's nginx caps request bodies at 12 MB, so raising this past that
# needs client_max_body_size raised with it or the upload dies at the proxy.
# ATTACHMENT_MAX_BYTES=8388608
# ATTACHMENT_MAX_TEXT_CHARS=20000
# ATTACHMENT_DESCRIPTION_MAX_CHARS=4000

# Optional: WaniKani deduplication. Also settable in the Settings screen.
# WANIKANI_API_TOKEN=

# AnkiConnect runs on your desktop, not on the server, so the default
# localhost address cannot work from inside this container. Point it at the
# machine running Anki, and add that origin to AnkiConnect's webCorsOriginList.
# ANKICONNECT_URL=http://192.168.1.50:8765

# Browser origins allowed by CORS. Irrelevant in this deployment: the UI goes
# through the frontend's nginx /api/ proxy, which makes its calls same-origin,
# so the browser applies no CORS check at all. Only set this if you publish the
# backend port and call it directly.
# CORS_ORIGINS=http://kanazawa.local:8085
