# --- Database (required) ---
# DB_URL carries only host/port/database; credentials come per role. The owner
# role runs DDL at startup, the app role serves requests. Both roles and the
# database must already exist -- see the bootstrap SQL in the deployment stack.
DB_URL=postgresql://localhost:5432/jp_conversation
DB_USER=jp_conversation_app
DB_PASSWORD=
DB_OWNER_USER=jp_conversation_owner
DB_OWNER_PASSWORD=

# No Postgres to point at? Use a local file instead and ignore the four role
# variables above -- SQLite has no roles. The directory is created on startup.
# Three slashes for a relative path, four for an absolute one:
#   DB_URL=sqlite:///./data/jp_conversation.db
#   DB_URL=sqlite:////var/lib/jp-conversation/jp_conversation.db

# --- OpenAI ---
# Everything below can also be set in the app's Settings screen, which stores
# it in the database and takes precedence over these defaults.
OPENAI_API_KEY=sk-...

# --- Optional: models ---
REALTIME_MODEL=gpt-realtime-2.1-mini
ANALYSIS_MODEL=gpt-4o-mini
# Assists in the scenario editor; separate so it can be a stronger model.
SCENARIO_ASSISTANT_MODEL=gpt-4o
REALTIME_VOICE=marin
REALTIME_SPEED=1.0
# Bounds offered by the speed slider; the backend clamps to these.
REALTIME_SPEED_MIN=0.6
REALTIME_SPEED_MAX=1.4
# How much the tutor slows down for a わからない turn. A factor on whatever
# tempo the session is running at, not a tempo of its own: at 1.0x the help
# comes at 0.8x, at 0.8x it comes at 0.64x. 1.0 disables the slowdown.
REALTIME_HELP_SPEED_FACTOR=0.8
# How readily a pause counts as the end of your turn: low | medium | high | auto.
# "low" waits longest, which is what a learner usually needs.
REALTIME_VAD_EAGERNESS=low
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Used to render the voice previews on the setup screen.
TTS_MODEL=gpt-4o-mini-tts
# Set to true only for pre-GA realtime models that still need the beta header.
REALTIME_BETA_HEADER=false

# --- Optional: context material ---
# Images a scenario can put in front of the learner. If you raise this, raise
# client_max_body_size in frontend/nginx.conf with it, or the upload is
# rejected by the proxy before it ever reaches this process.
ATTACHMENT_MAX_BYTES=8388608
ATTACHMENT_MAX_TEXT_CHARS=20000
# How much of a material description may reach the tutor's prompt.
ATTACHMENT_DESCRIPTION_MAX_CHARS=4000

# --- Optional: WaniKani deduplication (leave empty to disable) ---
WANIKANI_API_TOKEN=

# --- Optional: AnkiConnect ---
ANKICONNECT_URL=http://localhost:8765
ANKI_DECK_NAME=Japanese::AI Conversation

# --- Optional: CORS (comma separated) ---
CORS_ORIGINS=http://localhost:4200
